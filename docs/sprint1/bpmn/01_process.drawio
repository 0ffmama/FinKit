        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% Пул Клієнта\n    subgraph Клієнт\n        Start1((Початок:&lt;br&gt;Бажання кредиту)) --&gt; Client1[Відкрити розділ&lt;br&gt;Заявка на кредит]\n        Client2[Заповнити заявку:&lt;br&gt;сума, внесок, строк]\n    end\n\n    %% Пул Системи\n    subgraph Система_ФінКит\n        Sys1[Відобразити&lt;br&gt;форму заявки]\n        Sys2[Перевірити&lt;br&gt;введені дані]\n        XOR1{Дані&lt;br&gt;коректні?}\n        Sys3[Відобразити&lt;br&gt;помилку введення]\n        Sys4[[Підпроцес:&lt;br&gt;Обробка та оцінка]]\n        XOR2{Кредит&lt;br&gt;схвалено?}\n        Sys5[Повідомити&lt;br&gt;про відмову]\n        Sys6[Списати&lt;br&gt;перший внесок]\n        Sys7[Відкрити&lt;br&gt;кредитний рахунок]\n        Sys8[Повідомити&lt;br&gt;про успіх]\n        End1(((Кінець:&lt;br&gt;Відмовлено)))\n        End2(((Кінець:&lt;br&gt;Оформлено)))\n        \n        %% Послідовність у системі\n        Sys2 --&gt; XOR1\n        XOR1 -- Ні --&gt; Sys3\n        XOR1 -- Так --&gt; Sys4\n        Sys4 --&gt; XOR2\n        XOR2 -- Ні --&gt; Sys5\n        Sys5 --&gt; End1\n        XOR2 -- Так --&gt; Sys6\n        Sys6 --&gt; Sys7\n        Sys7 --&gt; Sys8\n        Sys8 --&gt; End2\n    end\n\n    %% Потоки повідомлень (пунктирні лінії між пулами)\n    Client1 -.-&gt; Sys1\n    Sys1 -.-&gt; Client2\n    Client2 -.-&gt; Sys2\n    Sys3 -.-&gt; Client2&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="6IVbzF9ixFPCeDmN6E8i-1">
